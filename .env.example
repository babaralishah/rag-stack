# Required for LLM generation and query rewriting
GROQ_API_KEY=your_groq_api_key

# Optional fallback LLM provider
GEMINI_API_KEY=your_gemini_api_key

# Optional but recommended for deeper, tagged coin news enrichment
# Signup: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key

# Optional but recommended for additional curated crypto news enrichment
# Signup: https://developers.coindesk.com/
COINDESK_DATA_API_KEY=your_coindesk_data_api_key

# Scanner result size (default 20)
SCAN_TOP_N=20

# Scanner volatility floor in percent (default 1.5)
SCALPING_MIN_VOLATILITY_PCT=1.5

# Deep-dive technical missing-field gate threshold (default 0.4)
TECHNICAL_MISSING_FIELD_THRESHOLD=0.4
